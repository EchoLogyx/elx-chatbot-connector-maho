<?xml version="1.0"?>
<config>
    <modules>
        <Elx_ChatbotConnector>
            <version>1.0.0</version>
        </Elx_ChatbotConnector>
    </modules>
    <global>
        <models>
            <elx_chatbotconnector>
                <class>Elx_ChatbotConnector_Model</class>
                <resourceModel>elx_chatbotconnector_resource</resourceModel>
            </elx_chatbotconnector>
            <elx_chatbotconnector_resource>
                <class>Elx_ChatbotConnector_Model_Resource</class>
                <entities>
                    <setting>
                        <table>elxchatbot_settings</table>
                    </setting>
                </entities>
            </elx_chatbotconnector_resource>
        </models>
        <blocks>
            <elx_chatbotconnector>
                <class>Elx_ChatbotConnector_Block</class>
            </elx_chatbotconnector>
        </blocks>
        <helpers>
            <elx_chatbotconnector>
                <class>Elx_ChatbotConnector_Helper</class>
            </elx_chatbotconnector>
        </helpers>
    </global>
    <default>
        <elx_chatbotconnector>
            <feed>
                <cron_expr>0 0 * * *</cron_expr>
            </feed>
        </elx_chatbotconnector>
    </default>
    <frontend>
        <layout>
            <updates>
                <elx_chatbotconnector>
                    <file>elx_chatbotconnector.xml</file>
                </elx_chatbotconnector>
            </updates>
        </layout>
    </frontend>
</config>
