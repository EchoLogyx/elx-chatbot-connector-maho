<script>
(function () {
    var formKey = <?= json_encode($formKey) ?>;

    function post(url, fields) {
        var body = new URLSearchParams(fields);
        body.set('form_key', formKey);
        body.set('isAjax', '1');
        return fetch(url, {
            method: 'POST',
            headers: {'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest'},
            body: body
        }).then(function (response) { return response.json(); });
    }

    function show(el, ok, text) {
        el.className = 'elx-msg ' + (ok ? 'success' : 'error');
        el.textContent = text;
    }

    var connectBtn = document.getElementById('elx-connect-btn');
    if (connectBtn) {
        connectBtn.addEventListener('click', function () {
            var input = document.getElementById('elx-secret-key');
            var msg = document.getElementById('elx-connect-msg');
            var key = input.value.trim();
            if (!key) {
                show(msg, false, 'Secret Key is required.');
                return;
            }
            connectBtn.disabled = true;
            post(connectBtn.dataset.url, {secret_key: key}).then(function (res) {
                connectBtn.disabled = false;
                show(msg, !!(res && res.success), (res && res.message) || 'Could not connect.');
                if (res && res.success) {
                    setTimeout(function () { window.location.reload(); }, 1200);
                }
            }).catch(function () {
                connectBtn.disabled = false;
                show(msg, false, 'Network error. Please check your connection.');
            });
        });
    }

    var feedBtn = document.getElementById('elx-feed-btn');
    if (feedBtn) {
        feedBtn.addEventListener('click', function () {
            var notify = document.getElementById('elx-feed-notify');
            feedBtn.disabled = true;
            post(feedBtn.dataset.url, {}).then(function (res) {
                feedBtn.disabled = false;
                show(notify, !!(res && res.success), (res && res.message) || 'Feed generation failed.');
                if (res && res.success) {
                    setTimeout(function () { window.location.reload(); }, 1500);
                }
            }).catch(function () {
                feedBtn.disabled = false;
                show(notify, false, 'Network error. Please try again.');
            });
        });
    }

    var interval = document.getElementById('elx-interval');
    if (interval) {
        interval.addEventListener('change', function () {
            var msg = document.getElementById('elx-interval-msg');
            interval.disabled = true;
            post(interval.dataset.url, {update_interval: interval.value}).then(function (res) {
                interval.disabled = false;
                show(msg, !!(res && res.success), (res && res.message) || 'Save failed.');
            }).catch(function () {
                interval.disabled = false;
                show(msg, false, 'Network error.');
            });
        });
    }

    var copy = document.getElementById('elx-copy-feed');
    if (copy) {
        copy.addEventListener('click', function (event) {
            event.preventDefault();
            var url = copy.getAttribute('data-url') || '';
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(url);
            }
        });
    }

    var orderBtn = document.getElementById('elx-order-access');
    if (orderBtn) {
        orderBtn.addEventListener('click', function () {
            var msg = document.getElementById('elx-order-msg');
            orderBtn.disabled = true;
            post(orderBtn.dataset.url, {}).then(function (res) {
                orderBtn.disabled = false;
                show(msg, !!(res && res.success), (res && res.message) || 'Could not set up order lookup.');
                if (res && res.success) {
                    setTimeout(function () { window.location.reload(); }, 900);
                }
            }).catch(function () {
                orderBtn.disabled = false;
                show(msg, false, 'Network error. Please try again.');
            });
        });
    }

    var secretOverlay = document.getElementById('elx-secret-overlay');
    var secretModal = document.getElementById('elx-secret-modal');
    function closeSecretModal() {
        if (secretOverlay) secretOverlay.style.display = 'none';
        if (secretModal) secretModal.style.display = 'none';
    }
    var openSecret = document.getElementById('elx-open-secret');
    if (openSecret) {
        openSecret.addEventListener('click', function () {
            secretOverlay.style.display = 'block';
            secretModal.style.display = 'block';
        });
        document.getElementById('elx-cancel-secret').addEventListener('click', closeSecretModal);
        secretOverlay.addEventListener('click', closeSecretModal);
        document.getElementById('elx-save-secret').addEventListener('click', function () {
            var btn = document.getElementById('elx-save-secret');
            var msg = document.getElementById('elx-secret-modal-msg');
            var secret = document.getElementById('elx-new-secret').value.trim();
            if (!secret) {
                show(msg, false, 'ELX secret is required.');
                return;
            }
            btn.disabled = true;
            post(btn.dataset.url, {secret_key: secret}).then(function (res) {
                btn.disabled = false;
                show(msg, !!(res && res.success), (res && res.message) || 'Could not update the ELX secret.');
                if (res && res.success) {
                    setTimeout(function () { window.location.reload(); }, 900);
                }
            }).catch(function () {
                btn.disabled = false;
                show(msg, false, 'Network error. Please try again.');
            });
        });
    }

    var logoutBtn = document.getElementById('elx-logout');
    if (logoutBtn) {
        logoutBtn.addEventListener('click', function () {
            var msg = document.getElementById('elx-secret-msg');
            if (!window.confirm('Remove the ELX secret stored for this store? You can connect again with a different one.')) {
                return;
            }
            logoutBtn.disabled = true;
            post(logoutBtn.dataset.url, {}).then(function (res) {
                logoutBtn.disabled = false;
                show(msg, !!(res && res.success), (res && res.message) || 'Could not remove the access token.');
                if (res && res.success) {
                    setTimeout(function () { window.location.reload(); }, 900);
                }
            }).catch(function () {
                logoutBtn.disabled = false;
                show(msg, false, 'Network error. Please try again.');
            });
        });
    }
})();
</script>
