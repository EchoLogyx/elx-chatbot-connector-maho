{
    "name": "elx/chatbot-connector",
    "description": "ELX Chatbot Connector for Maho - product feed generation and order data sync for the ELX Chatbot service.",
    "type": "maho-module",
    "license": "OSL-3.0",
    "keywords": [
        "maho",
        "elx",
        "chatbot"
    ],
    "homepage": "https://github.com/rajesh-echologyx/elx-chatbot-connector-maho",
    "support": {
        "issues": "https://github.com/rajesh-echologyx/elx-chatbot-connector-maho/issues",
        "source": "https://github.com/rajesh-echologyx/elx-chatbot-connector-maho"
    },
    "authors": [
        {
            "name": "Elx",
            "email": "support@elxchatbot.ai"
        }
    ],
    "require": {
        "php": ">=8.3",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "conflict": {
        "mahocommerce/maho": "<26.9"
    },
    "config": {
        "allow-plugins": {
            "mahocommerce/maho-composer-plugin": true
        }
    }
}
